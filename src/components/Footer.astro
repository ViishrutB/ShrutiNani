---
import { profileLinks, site } from '../site.config';

// A link with no href yet is dropped rather than rendered dead.
const links = profileLinks.filter(
  (link): link is { label: string; href: string } => link.href !== null,
);
const year = new Date().getFullYear();

// Recognizable glyphs for the two links that have them. Anything else in
// profileLinks (Google Scholar, ORCID — both still null today) falls back to
// a plain text label below; it doesn't need an icon defined to appear here.
const ICONS: Record<string, string> = {
  LinkedIn:
    '<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  Email:
    '<path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/><path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="m2.5 7 9.5 7 9.5-7"/>',
};
---

<footer class="mt-20 border-t border-rule">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}</p>
    {
      links.length > 0 && (
        <ul class="flex flex-wrap items-center gap-2">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-label={label}
                title={label}
                target={href.startsWith('mailto:') ? undefined : '_blank'}
                rel={href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-rule text-muted no-underline transition-colors hover:border-ink hover:text-ink"
              >
                {ICONS[label] ? (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" set:html={ICONS[label]} />
                ) : (
                  <span class="px-1 text-xs">{label}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
