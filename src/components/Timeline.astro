---
import type { TimelineItem } from '../lib/timeline';

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ol class="timeline relative border-l border-rule pl-6">
      {items.map((item) => (
        <li class="relative pb-10 last:pb-0">
          <span class="timeline-dot absolute top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-paper" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span class="text-xs font-medium uppercase tracking-wide text-muted">{item.category}</span>
            <span class="text-sm text-muted">{item.dateLabel}</span>
          </div>
          <h3 class="mt-1 text-lg font-semibold text-ink">
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink no-underline hover:text-accent"
              >
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </h3>
          {item.subtitle && (
            <p class="text-muted">
              {item.subtitle}
              {item.location ? ` · ${item.location}` : ''}
            </p>
          )}
          {item.summary && <p class="mt-2 max-w-prose text-sm text-ink">{item.summary}</p>}
          {item.highlights && item.highlights.length > 0 && (
            <ul class="mt-2 max-w-prose space-y-1 text-sm text-ink">
              {item.highlights.map((point) => (
                <li class="flex gap-2">
                  <span class="text-muted" aria-hidden="true">·</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
          {item.pdf && (
            <a
              href={item.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block text-sm text-accent underline underline-offset-4"
            >
              View PDF
            </a>
          )}
        </li>
      ))}
    </ol>
  )
}

<style>
  /*
   * The dot sits on the parent <ol>'s left border. `pl-6` (24px) is the gap
   * between that border and each <li>'s content, so the dot — 10px wide —
   * needs to sit 24px + half its own width to the left of the content edge.
   * The `ring` in the page background color punches a visual gap in the line
   * where the dot crosses it, instead of the line running straight through.
   */
  .timeline-dot {
    left: -29px;
  }
</style>
