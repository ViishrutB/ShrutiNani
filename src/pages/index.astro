---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

// One-entry collection, same pattern as `bio` — renders nothing at all,
// not even a heading, until the verse itself is confirmed and added. This
// is deliberately not something to guess at (see content.config.ts's
// comment on the `quote` collection).
const quoteEntries = await getCollection('quote');
const quoteEntry = quoteEntries[0];

// Replaces the old "M2 — highlight stats" placeholder: real photos Vishrut
// dropped in. Display order is curated, not chronological — the Emory and
// lab-bench photos sit at the end of the roll by request. Not a content
// collection — this is a one-off Home page section, not a schema other
// pages need (see the testimonials/quote collections for that pattern).
// Alt text sticks to what's visibly true; a caption asserting a specific
// venue or date only appears where it's independently confirmed elsewhere
// on the site (the Emory and Lake Conference entries match `experiences`
// and `presentations` records; the lab photos and white coat photo don't
// have a confirmed venue/date, so their alt text stays purely descriptive).
const LIFE_PHOTOS = [
  {
    src: '/images/life/white-coat.jpg',
    width: 480,
    height: 640,
    alt: 'Shruti in her white coat, outside a university building',
  },
  {
    src: '/images/life/lab-group.jpg',
    width: 853,
    height: 640,
    alt: 'Shruti with colleagues in white coats and scrubs in a lab',
  },
  {
    src: '/images/life/lab-meeting.jpg',
    width: 961,
    height: 640,
    alt: 'Shruti at a lab meeting, a slide on burst deep brain stimulation behind her',
  },
  {
    src: '/images/life/poster-lake-conference.jpg',
    width: 480,
    height: 640,
    alt: "Shruti presenting her poster at the Lake Conference on Sensation and Action, Thun, Switzerland, May 2023",
  },
  {
    src: '/images/life/phd-defense.jpg',
    width: 853,
    height: 640,
    alt: 'Shruti presenting her PhD dissertation defense, June 2025',
  },
  {
    src: '/images/life/poster-emory-mdsee.jpg',
    width: 480,
    height: 640,
    alt: "Shruti presenting a patient case poster during her MD Summer Experience at Emory, 2016",
  },
  {
    src: '/images/life/lab-bench-selfie.jpg',
    width: 853,
    height: 640,
    alt: 'Shruti in the lab beside a surgical microscope rig',
  },
];
---

<BaseLayout>
  <div class="mb-8 grid grid-cols-[96px_1fr] items-start gap-6 sm:grid-cols-[128px_1fr] sm:gap-7">
    <img
      src="/images/headshot.jpg"
      alt={site.name}
      width="128"
      height="128"
      class="aspect-square rounded-md border border-rule object-cover"
    />
    <div>
      <h1 class="text-4xl sm:text-5xl">{site.name}</h1>
      <p class="mt-2 font-serif text-xl italic text-muted">{site.tagline.role}</p>
      <p class="mt-1 max-w-prose text-ink">{site.tagline.focus}</p>
    </div>
  </div>

  <!--
    The site's one deliberate "bold" visual moment, spent here and nowhere
    else — see the design review in the project's chat history for why. Not a
    generic decorative wave: it traces a specific clinical story, left to
    right — bradykinesia (small, sluggish movement — the shallow humps),
    deep brain stimulation being applied (the pulse train), then movement
    amplitude restored (the larger humps). That's literally her thesis
    subject, not an aesthetic flourish borrowed from somewhere else.
  -->
  <svg
    viewBox="0 0 720 64"
    preserveAspectRatio="none"
    role="img"
    aria-label="Stylized trace of bradykinesia being corrected by deep brain stimulation: small, slow movement, a burst of stimulation pulses, then restored movement amplitude"
    class="mb-1 mt-9 h-12 w-full sm:mt-10"
  >
    <line x1="0" y1="48" x2="720" y2="48" stroke="var(--rule)" stroke-width="1" />
    <path
      d="M0,48 L40,48
         C 65,48 70,40 82,40 C 94,40 99,48 125,48
         C 150,48 155,40 167,40 C 179,40 184,48 220,48
         L260,48
         L270,48 L270,22 L278,22 L278,48
         L305,48 L305,22 L313,22 L313,48
         L340,48 L340,22 L348,22 L348,48
         L375,48 L375,22 L383,22 L383,48
         L460,48
         L500,48
         C 520,48 524,14 540,14 C 556,14 560,48 585,48
         C 605,48 609,14 625,14 C 641,14 645,48 680,48
         L720,48"
      fill="none"
      stroke="var(--accent)"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <p class="mb-10 text-xs text-muted">
    bradykinesia — reduced movement amplitude — restored after deep brain stimulation
  </p>

  {quoteEntry && (
    <blockquote class="mb-10 border-t border-rule pt-8">
      <p class="max-w-prose font-serif text-lg italic text-ink">
        &ldquo;{quoteEntry.data.translation}&rdquo;
      </p>
      {quoteEntry.data.source && (
        <footer class="mt-2 text-xs text-muted">— {quoteEntry.data.source}</footer>
      )}
    </blockquote>
  )}

  <section class="border-t border-rule pt-8" aria-label="Photos from training and research">
    <ul id="life-carousel" class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1">
      {LIFE_PHOTOS.map((photo) => (
        <li class="shrink-0 snap-start">
          <img
            src={photo.src}
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            class="h-56 w-auto rounded-md border border-rule object-cover sm:h-64"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
    <div class="mt-3 flex justify-end gap-2">
      <button type="button" data-carousel-scroll="-1" aria-label="Scroll photos left" class="carousel-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M12 4 6 10l6 6" />
        </svg>
      </button>
      <button type="button" data-carousel-scroll="1" aria-label="Scroll photos right" class="carousel-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="m8 4 6 6-6 6" />
        </svg>
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  #life-carousel {
    scroll-padding-inline: 1px;
    scrollbar-width: thin;
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    background: transparent;
    cursor: pointer;
  }

  .carousel-btn:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>

<script>
  // Native scroll-snap does the actual carousel work with zero JS; this
  // just gives mouse/trackpad users an explicit control, same role as a
  // scrollbar. Degrades to plain horizontal scrolling with JS disabled.
  const track = document.getElementById('life-carousel');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-carousel-scroll]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const direction = Number(button.dataset.carouselScroll);
      track?.scrollBy({ left: direction * track.clientWidth * 0.85, behavior: 'smooth' });
    });
  });
</script>
