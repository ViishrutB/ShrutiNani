---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';

// One-entry collection (see content.config.ts) — take whichever file is
// there, since exactly one is expected.
const bioEntries = await getCollection('bio');
const bioEntry = bioEntries[0];
const { Content } = bioEntry ? await render(bioEntry) : { Content: null };

// Renders nothing at all, not even a heading, when empty — the design doc is
// explicit that this section shouldn't need content to exist before the page
// is safe to deploy.
const testimonials = (await getCollection('testimonials')).filter((t) => t.data.featured);
---

<BaseLayout title="Purpose">
  <PageHeader title="Purpose" />

  {!bioEntry && <Placeholder milestone="M3 — Purpose page: statement of purpose" />}

  {Content && (
    // Deliberately narrower than the site's usual max-w-prose (65ch): that
    // value renders close to the width of the outer content column at this
    // page's font size, so it wasn't actually the binding constraint — lines
    // were running ~95+ characters. Justified text wants a narrower column
    // than ragged-right does (that's why newspapers set it in columns, not
    // full-width) or the word-spacing stretches get visibly uneven.
    //
    // font-serif + text-lg here specifically: this is the one page on the
    // site meant to read as a personal essay rather than reference material
    // (the Timeline's Technical Strengths block reuses .prose-content too,
    // and stays in the body sans — it's data, not narrative).
    <div class="prose-content essay max-w-[58ch] text-justify hyphens-auto font-serif text-lg">
      <Content />
    </div>
  )}

  {testimonials.length > 0 && (
    <section class="mt-14 border-t border-rule pt-10">
      <h2 class="text-xl">What people say</h2>
      <ul class="mt-6 space-y-8">
        {testimonials.map((t) => (
          <li>
            <blockquote class="max-w-prose text-lg italic text-ink">&ldquo;{t.data.quote}&rdquo;</blockquote>
            <p class="mt-2 text-sm text-muted">
              — {t.data.author}
              {t.data.role ? `, ${t.data.role}` : ''}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /*
   * A functional drop cap — it marks where the essay begins, the one place
   * on the page that gets a typographic flourish, rather than decorating
   * every paragraph the same way. Vermilion ties it to the site's one accent
   * color instead of introducing a second one just for this.
   */
  .essay :global(p:first-of-type)::first-letter {
    float: left;
    font-size: 3.2em;
    line-height: 0.82;
    padding: 0.03em 0.08em 0 0;
    font-weight: 600;
    color: var(--accent);
  }
</style>
