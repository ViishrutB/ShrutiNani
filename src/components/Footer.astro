---
import { profileLinks, site } from '../site.config';

// A link with no href yet is dropped rather than rendered dead.
const links = profileLinks.filter((link) => link.href !== null);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule">
  <div class="mx-auto flex max-w-3xl flex-col gap-2 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}</p>
    {
      links.length > 0 && (
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} class="text-muted underline decoration-rule underline-offset-4 hover:text-ink">
                {label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
