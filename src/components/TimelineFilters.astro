---
/**
 * Filter pills for the Timeline page: "All" plus one per distinct category
 * (order computed by src/lib/timeline.ts's orderCategories). Filtering itself
 * happens client-side against Timeline.astro's `data-category` attributes —
 * no framework, just enough inline JS to toggle `hidden`. Progressive
 * enhancement: with JS disabled, every entry stays visible and the pills are
 * inert, which is a reasonable "no filtering" fallback, not a broken page.
 *
 * Doubles as the categorical palette's legend — each pill's dot uses the same
 * --cat-* custom properties Timeline.astro defines, so this is the one place
 * that documents what each color means (the dataviz skill requires a legend
 * for any categorical encoding with 2+ series; reusing the filter bar avoids
 * a second, redundant color key).
 */
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<div
  class="mb-8 flex flex-wrap gap-2"
  role="group"
  aria-label="Filter the timeline by category"
  data-timeline-filters
>
  <button type="button" data-filter="All" aria-pressed="true" class="timeline-filter-pill">
    All
  </button>
  {
    categories.map((category) => (
      <button type="button" data-filter={category} aria-pressed="false" class="timeline-filter-pill">
        <span class="pill-dot" aria-hidden="true" />
        {category}
      </button>
    ))
  }
</div>

<style>
  .timeline-filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      border-color 0.15s;
  }

  .timeline-filter-pill:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .timeline-filter-pill[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Same categorical palette Timeline.astro defines on :root — see that
     component for the validation notes. The "All" pill has no dot: it isn't
     one category, it's the absence of a filter. */
  .pill-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--trace);
  }
  [data-filter='Education'] .pill-dot {
    background: var(--cat-education);
  }
  [data-filter='Research Experience'] .pill-dot {
    background: var(--cat-research);
  }
  [data-filter='Leadership Experience'] .pill-dot {
    background: var(--cat-leadership);
  }
  [data-filter='Honors & Awards'] .pill-dot {
    background: var(--cat-honors);
  }
  [data-filter='Publication'] .pill-dot {
    background: var(--cat-publication);
  }
  [data-filter='Doctoral Thesis'] .pill-dot {
    background: var(--cat-thesis);
  }
  [data-filter='Presentation'] .pill-dot {
    background: var(--cat-presentation);
  }
</style>

<script>
  // Scoped to this page's one filter group + the timeline it controls — see
  // Timeline.astro for the #timeline-list / data-category it reads.
  const group = document.querySelector<HTMLElement>('[data-timeline-filters]');
  const list = document.getElementById('timeline-list');
  if (group && list) {
    const buttons = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = list.querySelectorAll<HTMLLIElement>('[data-category]');

    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;

      const filter = button.dataset.filter;
      items.forEach((item) => {
        item.hidden = filter !== 'All' && item.dataset.category !== filter;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    });
  }
</script>
