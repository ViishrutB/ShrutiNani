---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import FilterPills from '../components/FilterPills.astro';
import { splitAuthors } from '../lib/authors';

const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

// Same pattern as the Timeline's CV check: the frontmatter can name a PDF
// before the file actually exists, so the embedded viewer and download link
// only appear once it's really there.
function pdfFileExists(pdfPath: string | null): boolean {
  if (!pdfPath) return false;
  return fs.existsSync(path.join(process.cwd(), 'public', pdfPath));
}

// Fixed, meaningful order (not alphabetical) — only shows a pill for a role
// that actually appears among the publications, same principle as the
// Timeline's orderCategories. A doctoral thesis has exactly one author by
// definition, so "sole author" is its own value — not folded into "first
// author," which would misreport a co-authored paper's byline as identical
// to an unco-authored thesis.
const ROLE_ORDER = ['sole author', 'first author', 'second author', 'co-author'];
const roles = ROLE_ORDER.filter((role) => publications.some((pub) => pub.data.role === role));
---

<BaseLayout title="Publications">
  <PageHeader title="Publications" />

  {publications.length === 0 && <Placeholder milestone="M5 — Publications page: 4 papers plus thesis" />}

  {publications.length > 0 && (
    <>
      {roles.length > 1 && (
        <FilterPills
          listId="publications-list"
          itemAttribute="role"
          values={roles}
          label="Filter publications by author position"
          withDots
        />
      )}

      <ul id="publications-list" class="divide-y divide-rule">
        {publications.map((pub) => {
          const isThesis = pub.data.type === 'Doctoral Thesis';
          const hasPdf = pdfFileExists(pub.data.pdf);
          return (
            <li class="pub-entry py-6 first:pt-0" data-role={pub.data.role}>
              {/* Bibliography convention, not a card: a hanging year column is
                 how a citation list is actually set, not an invented layout. */}
              <p class="pub-year tabular-nums pt-0.5 text-sm font-medium text-muted">{pub.data.year}</p>
              <div>
                <h2 class="text-lg font-semibold text-ink">
                  {pub.data.link ? (
                    <a href={pub.data.link} target="_blank" rel="noopener noreferrer" class="text-ink no-underline hover:text-accent">
                      {pub.data.title}
                    </a>
                  ) : (
                    pub.data.title
                  )}
                </h2>

                {pub.data.authors && (
                  <p class="mt-1 text-sm text-ink">
                    {splitAuthors(pub.data.authors).map((segment) =>
                      segment.highlight ? <strong class="font-semibold">{segment.text}</strong> : segment.text,
                    )}
                  </p>
                )}

                <p class="mt-1 text-sm text-muted">
                  {pub.data.journal && <em>{pub.data.journal}</em>}
                  {pub.data.institution}
                  {pub.data.volume && `, ${pub.data.volume}`}
                  {pub.data.pages && `, ${pub.data.pages}`}
                </p>

                {pub.data.role && (
                  <span class="role-pill mt-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium capitalize" data-badge-role={pub.data.role}>
                    {pub.data.role}
                  </span>
                )}

                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                  {pub.data.link && (
                    <a
                      href={pub.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-accent underline underline-offset-4"
                    >
                      Read on {pub.data.journal}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-3.5 w-3.5"
                        aria-hidden="true"
                      >
                        <path d="M6 4h6v6M12 4 4 12" />
                      </svg>
                    </a>
                  )}
                  {hasPdf && (
                    <>
                      <button
                        type="button"
                        data-open-modal={`pdf-modal-${pub.id}`}
                        class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3.5 py-1.5 text-sm font-medium text-paper transition-opacity hover:opacity-90"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-4 w-4"
                          aria-hidden="true"
                        >
                          <path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6-8.5-6-8.5-6Z" />
                          <circle cx="10" cy="10" r="2.25" />
                        </svg>
                        {isThesis ? 'View Thesis' : 'View PDF'}
                      </button>
                      <a href={pub.data.pdf!} download class="text-sm text-accent underline underline-offset-4">
                        Download PDF
                      </a>
                    </>
                  )}
                  {isThesis && !hasPdf && (
                    <span class="text-sm italic text-muted">Thesis PDF coming soon</span>
                  )}
                </div>

                {hasPdf && (
                  <dialog id={`pdf-modal-${pub.id}`} class="pdf-modal" aria-label={pub.data.title}>
                    <div class="pdf-modal-bar">
                      <p class="pdf-modal-title">{pub.data.title}</p>
                      <button type="button" data-close-modal aria-label="Close">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          class="h-4 w-4"
                          aria-hidden="true"
                        >
                          <path d="M5 5l10 10M15 5 5 15" />
                        </svg>
                      </button>
                    </div>
                    <object data={pub.data.pdf!} type="application/pdf" class="pdf-modal-frame" aria-label={pub.data.title}>
                      <p class="p-4 text-sm text-muted">
                        Your browser can't preview PDFs inline. <a href={pub.data.pdf!} class="text-accent underline underline-offset-4">Download the thesis</a> instead.
                      </p>
                    </object>
                  </dialog>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  /* Same hanging-indent bibliography convention as the mockup: a fixed year
     column, content beside it. Collapses to a single column on phones. */
  .pub-entry {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 1rem;
  }

  @media (max-width: 560px) {
    .pub-entry {
      grid-template-columns: 1fr;
      row-gap: 0.25rem;
    }

    .pub-year {
      padding-top: 0;
    }
  }

  /*
   * Author-position palette — green/yellow/blue as requested. Same hue
   * family as the Timeline's green/yellow/blue category slots, but these
   * light-mode values are darkened past those (which were tuned as marks on
   * the page background, a different job) because here the color IS the
   * pill's text: checked with a canvas-resolved WCAG contrast calc against
   * each pill's own soft background — 5.1–7.2:1, all clear the 4.5:1 small-
   * text floor with real margin. The `-soft` token is the pale pill fill;
   * the bare token doubles as the filter dot's fill, which needs the
   * stronger mark a pale tint wouldn't give it.
   */
  :global(:root) {
    --role-sole: oklch(45% 0.17 300);
    --role-sole-soft: oklch(94% 0.05 300);
    --role-first: oklch(45% 0.15 145);
    --role-first-soft: oklch(94% 0.05 145);
    --role-second: oklch(42% 0.13 75);
    --role-second-soft: oklch(94% 0.06 85);
    --role-co: oklch(50% 0.16 255);
    --role-co-soft: oklch(94% 0.04 255);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) {
      --role-sole: #c98bf0;
      --role-sole-soft: oklch(27% 0.06 300);
      --role-first: #4ade80;
      --role-first-soft: oklch(26% 0.06 145);
      --role-second: #eab308;
      --role-second-soft: oklch(27% 0.07 85);
      --role-co: #7db8f2;
      --role-co-soft: oklch(27% 0.05 255);
    }
  }

  :global(:root[data-theme='dark']) {
    --role-sole: #c98bf0;
    --role-sole-soft: oklch(27% 0.06 300);
    --role-first: #4ade80;
    --role-first-soft: oklch(26% 0.06 145);
    --role-second: #eab308;
    --role-second-soft: oklch(27% 0.07 85);
    --role-co: #7db8f2;
    --role-co-soft: oklch(27% 0.05 255);
  }

  /* Pill: pale tint behind, saturated text on top. Dot: no text to sit on,
     so it gets the saturated color directly as its fill — a pale dot would
     barely register as a mark against the page background. */
  .role-pill[data-badge-role='sole author'] {
    color: var(--role-sole);
    background: var(--role-sole-soft);
  }
  .role-pill[data-badge-role='first author'] {
    color: var(--role-first);
    background: var(--role-first-soft);
  }
  .role-pill[data-badge-role='second author'] {
    color: var(--role-second);
    background: var(--role-second-soft);
  }
  .role-pill[data-badge-role='co-author'] {
    color: var(--role-co);
    background: var(--role-co-soft);
  }

  :global([data-filter='sole author'] .pill-dot) {
    background: var(--role-sole);
  }
  :global([data-filter='first author'] .pill-dot) {
    background: var(--role-first);
  }
  :global([data-filter='second author'] .pill-dot) {
    background: var(--role-second);
  }
  :global([data-filter='co-author'] .pill-dot) {
    background: var(--role-co);
  }

  /*
   * Native <dialog> instead of a hand-rolled overlay: free focus-trapping,
   * Escape-to-close, and top-layer stacking. Flex-column layout so the PDF
   * frame fills whatever space the title bar doesn't, rather than a fixed
   * height fighting the bar's actual rendered size.
   *
   * `display` lives on the `[open]` variant, not the bare class: a browser's
   * own UA stylesheet hides a <dialog> by default until it's opened, but
   * that default only holds until an AUTHOR stylesheet declares `display`
   * for the same element — origin beats specificity in the cascade, so even
   * a plain class selector here overrides the browser's built-in hidden
   * state. Putting a bare `.pdf-modal { display: flex }` was exactly that
   * mistake: it forced the dialog visible (in-flow, unstyled positioning)
   * on every page load, closed or not. Scoping it to `[open]` — the
   * attribute `showModal()`/`close()` actually toggle — leaves the closed
   * state to the browser's own default and only takes over once it's
   * genuinely open.
   */
  .pdf-modal[open] {
    display: flex;
    flex-direction: column;
    /*
     * A modal <dialog> centers itself natively — the browser's own UA rule
     * gives it `position: fixed; inset: 0` plus `margin: auto`, and that
     * combination is what centers a box with a definite width/height inside
     * the viewport. Tailwind's Preflight resets margin to 0 on every
     * element site-wide (the usual "remove browser default margins" reset),
     * which zeroes out the one property that trick depends on — the dialog
     * was still landing at inset 0 on every side, just pinned to the
     * top-left instead of centered. Restoring it here rather than carving
     * an exception into Preflight: this is the one element on the site that
     * actually needs it.
     */
    margin: auto;
  }

  .pdf-modal {
    width: min(920px, 92vw);
    height: min(88vh, 1000px);
    padding: 0;
    border: none;
    border-radius: 0.75rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.45);
  }

  .pdf-modal::backdrop {
    background: rgba(15, 15, 20, 0.55);
    backdrop-filter: blur(2px);
  }

  .pdf-modal-bar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .pdf-modal-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pdf-modal-bar button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .pdf-modal-bar button:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .pdf-modal-frame {
    flex: 1;
    width: 100%;
    border: none;
  }

  @media (max-width: 560px) {
    .pdf-modal {
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
    }
  }
</style>

<script>
  // Native <dialog> gives Escape-to-close and modal focus-trapping for free —
  // this just wires the trigger button, the explicit close button, and a
  // click on the backdrop (a click lands on the <dialog> element itself only
  // when it's outside the actual content box, which is exactly "the user
  // clicked outside").
  document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.openModal!);
    if (!(dialog instanceof HTMLDialogElement)) return;
    button.addEventListener('click', () => dialog.showModal());
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.pdf-modal').forEach((dialog) => {
    dialog.querySelector('[data-close-modal]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
