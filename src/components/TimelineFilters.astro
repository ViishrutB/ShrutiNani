---
/**
 * Filter pills for the Timeline page: "All" plus one per distinct category
 * (order computed by src/lib/timeline.ts's orderCategories). Filtering itself
 * happens client-side against Timeline.astro's `data-category` attributes —
 * no framework, just enough inline JS to toggle `hidden`. Progressive
 * enhancement: with JS disabled, every entry stays visible and the pills are
 * inert, which is a reasonable "no filtering" fallback, not a broken page.
 */
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<div
  class="mb-8 flex flex-wrap gap-2"
  role="group"
  aria-label="Filter the timeline by category"
  data-timeline-filters
>
  <button type="button" data-filter="All" aria-pressed="true" class="timeline-filter-pill">
    All
  </button>
  {
    categories.map((category) => (
      <button type="button" data-filter={category} aria-pressed="false" class="timeline-filter-pill">
        {category}
      </button>
    ))
  }
</div>

<style>
  .timeline-filter-pill {
    border-radius: 9999px;
    border: 1px solid var(--rule);
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      border-color 0.15s;
  }

  .timeline-filter-pill:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .timeline-filter-pill[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  // Scoped to this page's one filter group + the timeline it controls — see
  // Timeline.astro for the #timeline-list / data-category it reads.
  const group = document.querySelector<HTMLElement>('[data-timeline-filters]');
  const list = document.getElementById('timeline-list');
  if (group && list) {
    const buttons = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = list.querySelectorAll<HTMLLIElement>('[data-category]');

    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;

      const filter = button.dataset.filter;
      items.forEach((item) => {
        item.hidden = filter !== 'All' && item.dataset.category !== filter;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    });
  }
</script>
