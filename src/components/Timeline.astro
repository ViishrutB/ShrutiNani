---
import type { TimelineItem } from '../lib/timeline';

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ol id="timeline-list" class="divide-y divide-rule">
      {items.map((item) => (
        <li class="tl-entry py-5 first:pt-0" data-category={item.category}>
          {/* Color carries identity (which category), the text label carries
             the reading — never the reverse. The swatch is a categorical
             palette (7 hues, validated for CVD separation and contrast per
             mode — see the color-coded key in TimelineFilters.astro); the
             label next to it stays in ordinary ink, per the same rule links
             and everything else on this site follow: a colored mark sits
             beside text, it doesn't replace it. */}
          <span class="tl-swatch rounded-full" aria-hidden="true" />
          <div>
            <p class="text-sm font-medium text-muted">{item.category}</p>
            <h3 class="mt-0.5 text-lg font-semibold text-ink">
              {item.href ? (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink no-underline hover:text-accent"
                >
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            {item.subtitle && <p class="mt-1 text-ink">{item.subtitle}</p>}
            {item.location && <p class="text-sm text-muted">{item.location}</p>}
            {item.summary && <p class="mt-2 max-w-prose text-sm text-ink">{item.summary}</p>}
            {item.highlights && item.highlights.length > 0 && (
              <ul class="mt-2 max-w-prose space-y-1 text-sm text-ink">
                {item.highlights.map((point) => (
                  <li class="flex gap-2">
                    <span class="text-muted" aria-hidden="true">
                      ·
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}
            {item.pdf && (
              <a
                href={item.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-block text-sm text-accent underline underline-offset-4"
              >
                View PDF
              </a>
            )}
          </div>
          <p class="tl-date tabular-nums text-sm text-muted">{item.dateLabel}</p>
        </li>
      ))}
    </ol>
  )
}

<style>
  /*
   * Seven-hue categorical palette (dataviz skill's validated default,
   * reordered so the closest hue to the site's own --accent — red — is
   * dropped rather than risking it read as "this is a link"). Adjacent-pair
   * CVD separation and contrast both validated with `validate_palette.js`
   * against this site's actual light/dark surfaces — all-pairs does not
   * clear the same floor at 7 slots (only the first 3 do, per the skill's
   * own reference data), which is why the category name is always printed
   * in plain ink right beside the swatch: color speeds up scanning, the
   * text is what actually carries the identity.
   *
   * "Presentation" is the fallback category (see src/lib/timeline.ts) until
   * poster-vs-talk is confirmed — it and any future category default to
   * --trace via the base rule below, so nothing ever renders uncolored.
   */
  :global(:root) {
    --cat-education: #2a78d6;
    --cat-research: #eb6834;
    --cat-leadership: #1baf7a;
    --cat-honors: #eda100;
    --cat-publication: #e87ba4;
    --cat-thesis: #008300;
    --cat-presentation: #4a3aa7;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) {
      --cat-education: #3987e5;
      --cat-research: #d95926;
      --cat-leadership: #199e70;
      --cat-honors: #c98500;
      --cat-publication: #d55181;
      --cat-thesis: #008300;
      --cat-presentation: #9085e9;
    }
  }

  :global(:root[data-theme='dark']) {
    --cat-education: #3987e5;
    --cat-research: #d95926;
    --cat-leadership: #199e70;
    --cat-honors: #c98500;
    --cat-publication: #d55181;
    --cat-thesis: #008300;
    --cat-presentation: #9085e9;
  }

  .tl-swatch {
    background: var(--trace);
  }
  /*
   * Each rule pairs the entry's own swatch (rendered here, in this
   * component — an ordinary scoped selector) with the matching filter
   * pill's dot (rendered by the separate FilterPills instance on the page —
   * needs :global() to reach across that component boundary).
   *
   * `.pill-dot.pill-dot` (the class repeated) isn't a typo: FilterPills.astro
   * has its own scoped default (`.pill-dot { background: var(--trace) }`,
   * astro-cid-qualified) sitting at the exact same specificity — one class
   * either way — as a bare `[data-filter='X'] .pill-dot`. Which one won
   * depended on which component's stylesheet Astro happened to bundle
   * second, not on anything in this file, so it was silently coin-flippable
   * across rebuilds. Doubling the class is the standard zero-cost way to
   * outrank a tied selector deterministically, rather than hoping build
   * output ordering keeps cooperating.
   */
  [data-category='Education'] .tl-swatch,
  :global([data-filter='Education'] .pill-dot.pill-dot) {
    background: var(--cat-education);
  }
  [data-category='Research Experience'] .tl-swatch,
  :global([data-filter='Research Experience'] .pill-dot.pill-dot) {
    background: var(--cat-research);
  }
  [data-category='Leadership Experience'] .tl-swatch,
  :global([data-filter='Leadership Experience'] .pill-dot.pill-dot) {
    background: var(--cat-leadership);
  }
  [data-category='Honors & Awards'] .tl-swatch,
  :global([data-filter='Honors & Awards'] .pill-dot.pill-dot) {
    background: var(--cat-honors);
  }
  [data-category='Publication'] .tl-swatch,
  :global([data-filter='Publication'] .pill-dot.pill-dot) {
    background: var(--cat-publication);
  }
  [data-category='Doctoral Thesis'] .tl-swatch,
  :global([data-filter='Doctoral Thesis'] .pill-dot.pill-dot) {
    background: var(--cat-thesis);
  }
  [data-category='Presentation'] .tl-swatch,
  :global([data-filter='Presentation'] .pill-dot.pill-dot) {
    background: var(--cat-presentation);
  }

  /*
   * Grid instead of the old border-left-line-plus-absolute-dot: each entry
   * gets its own short colored rule rather than crossing a continuous line,
   * and the date sits in its own column instead of sharing a row with the
   * category label. Collapses to two columns on narrow screens — the date
   * drops under the title instead of fighting the content column for room.
   */
  .tl-entry {
    display: grid;
    grid-template-columns: 3px 1fr auto;
    column-gap: 1rem;
    align-items: start;
  }

  .tl-entry > span {
    align-self: stretch;
    min-height: 1.75rem;
  }

  .tl-date {
    white-space: nowrap;
    padding-top: 0.125rem;
  }

  @media (max-width: 560px) {
    .tl-entry {
      grid-template-columns: 3px 1fr;
    }

    .tl-date {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
