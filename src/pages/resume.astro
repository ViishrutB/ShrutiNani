---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import Timeline from '../components/Timeline.astro';
import type { TimelineItem } from '../lib/timeline';
import { formatDateRange, sortKey, toSortableMonth } from '../lib/dates';

// The CV PDF is dropped into public/documents/ directly (not through a
// content collection — it's one static file, not structured data). Checked
// at build time so the page degrades cleanly to the HTML timeline alone
// until the file exists.
const CV_PDF_PATH = '/documents/CV_SN.pdf';
const cvPdfExists = fs.existsSync(path.join(process.cwd(), 'public', 'documents', 'CV_SN.pdf'));

const [resumeEntries, publicationEntries, presentationEntries] = await Promise.all([
  getCollection('resume'),
  getCollection('publications'),
  getCollection('presentations'),
]);

// Every CV fact has exactly one home: education/positions/honors live in the
// `resume` collection, but publications and presentations already have their
// own collections (they're sourced from the CV too — see design doc §3), so
// they're pulled in here rather than duplicated as separate resume entries.
const items: (TimelineItem & { _sort: number; _sortTiebreak: number })[] = [
  ...resumeEntries.map((entry) => ({
    id: entry.id,
    category: entry.data.category,
    title: entry.data.title,
    subtitle: entry.data.org,
    location: entry.data.location,
    dateLabel: formatDateRange(entry.data),
    summary: entry.data.summary,
    highlights: entry.data.highlights,
    _sort: sortKey(entry.data),
    _sortTiebreak: toSortableMonth(entry.data.startDate),
  })),
  ...publicationEntries.map((entry) => {
    const year = String(entry.data.year);
    return {
      id: entry.id,
      category: entry.data.type === 'Doctoral Thesis' ? 'Doctoral Thesis' : 'Publication',
      title: entry.data.title,
      subtitle: entry.data.journal ?? entry.data.institution,
      dateLabel: formatDateRange({ startDate: year }),
      href: entry.data.link ?? undefined,
      pdf: entry.data.pdf,
      _sort: sortKey({ startDate: year }),
      _sortTiebreak: toSortableMonth(year),
    };
  }),
  ...presentationEntries.map((entry) => {
    const year = String(entry.data.year);
    return {
      id: entry.id,
      category: entry.data.type ?? 'Presentation',
      title: entry.data.title,
      subtitle: entry.data.venue,
      location: entry.data.location,
      dateLabel: entry.data.date ?? formatDateRange({ startDate: year }),
      pdf: entry.data.pdf,
      _sort: sortKey({ startDate: year }),
      _sortTiebreak: toSortableMonth(year),
    };
  }),
].sort((a, b) => b._sort - a._sort || b._sortTiebreak - a._sortTiebreak);

const hasContent = items.length > 0 || cvPdfExists;

const skillsEntries = await getCollection('skills');
const skillsEntry = skillsEntries[0];
const { Content: SkillsContent } = skillsEntry ? await render(skillsEntry) : { Content: null };
---

<BaseLayout title="Resume">
  <PageHeader title="Resume" lede="Full curriculum vitae." />

  {!hasContent && <Placeholder milestone="M2 — Resume page: embedded CV PDF and HTML mirror" />}

  {cvPdfExists && (
    <div class="mb-12">
      <a
        href={CV_PDF_PATH}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-accent underline underline-offset-4"
      >
        Download as PDF
      </a>
      <object
        data={CV_PDF_PATH}
        type="application/pdf"
        class="mt-3 h-[75vh] w-full rounded-lg border border-rule"
        aria-label="Shruti Nanivadekar's CV"
      >
        <p class="p-4 text-sm text-muted">
          Your browser can't preview PDFs inline. <a href={CV_PDF_PATH} class="text-accent underline underline-offset-4">Download the CV</a> instead.
        </p>
      </object>
    </div>
  )}

  {items.length > 0 && <Timeline items={items} />}

  {skillsEntry && SkillsContent && (
    <section class="mt-14 border-t border-rule pt-10">
      <h2 class="text-xl">{skillsEntry.data.title}</h2>
      <div class="prose-content mt-6 max-w-prose">
        <SkillsContent />
      </div>
    </section>
  )}
</BaseLayout>
